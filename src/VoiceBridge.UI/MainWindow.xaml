<Window x:Class="VoiceBridge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceBridge - Real-Time Voice Processing &amp; Virtual Microphone"
        Height="740" Width="1120"
        MinHeight="680" MinWidth="980"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Top Navigation & Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Status Bar Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!-- TOP HEADER & CONTROLS                                             -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎙️ VoiceBridge" Foreground="{StaticResource AccentCyanBrush}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#1A222D" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,4" Margin="20,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EngineState}" Foreground="{StaticResource AccentGreenBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Bypass Effects" Command="{Binding ToggleBypassCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                    <Button Content="{Binding EngineButtonText}" Command="{Binding ToggleEngineCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!-- MAIN DASHBOARD CONTENT                                            -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Panel: Devices & VU Metering -->
                <ColumnDefinition Width="360"/>
                <!-- Right Panel: Voice Presets & DSP Effects -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <!-- Card 1: Audio Device Routing -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Audio Hardware Routing" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                        <!-- Input Device Selector -->
                        <TextBlock Text="Physical Microphone Input" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Devices.InputDevices}" DisplayMemberPath="Name" SelectedItem="{Binding Devices.SelectedInputDevice}" Margin="0,0,0,14" Height="34"/>

                        <!-- Output Device Selector -->
                        <TextBlock Text="Playback / Virtual Output" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Devices.OutputDevices}" DisplayMemberPath="Name" SelectedItem="{Binding Devices.SelectedOutputDevice}" Margin="0,0,0,14" Height="34"/>

                        <!-- Virtual Driver Status -->
                        <Border Background="#121820" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <TextBlock Text="🔌 Virtual Cable Driver:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Detected &amp; Ready" Foreground="{StaticResource AccentGreenBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 2: Live Peak Metering -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Live VU Peak Metering" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                        <!-- Input Meter -->
                        <TextBlock Text="Input Microphone Level" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Minimum="-60" Maximum="0" Value="{Binding InputPeakDb}" Style="{StaticResource VuMeterBarStyle}" Height="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding InputPeakDb, StringFormat={}{0:F1} dB}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Output Meter -->
                        <TextBlock Text="Processed Output Level" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Minimum="-60" Maximum="0" Value="{Binding OutputPeakDb}" Style="{StaticResource VuMeterBarStyle}" Height="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding OutputPeakDb, StringFormat={}{0:F1} dB}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT PANEL -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="14,0,0,0">
                <StackPanel>
                    <!-- Card 3: Voice Presets -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Voice Profile Presets" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding Presets.Presets}" DisplayMemberPath="Name" SelectedItem="{Binding Presets.SelectedPreset}" Height="34" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding Presets.SelectedPreset.Description}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Real-Time DSP Effect Sliders -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Real-Time DSP Effects Chain" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,18"/>

                            <!-- Gain Control -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Input Gain Factor" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" Value="{Binding Effects.GainFactor}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Effects.GainFactor, StringFormat={}{0:F2}x}" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Noise Gate Threshold -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Noise Gate Threshold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="-80.0" Maximum="0.0" Value="{Binding Effects.GateThresholdDb}" SmallChange="1" LargeChange="5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Effects.GateThresholdDb, StringFormat={}{0:F0} dB}" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Pitch Shift -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pitch Shift (Semitones)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="-12.0" Maximum="12.0" Value="{Binding Effects.PitchSemitones}" SmallChange="1" LargeChange="2" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Effects.PitchSemitones, StringFormat={}{0:F0} st}" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Delay Time -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Delay Time (ms)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="10.0" Maximum="1000.0" Value="{Binding Effects.DelayMs}" SmallChange="10" LargeChange="50" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Effects.DelayMs, StringFormat={}{0:F0} ms}" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Reverb Room Size -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Reverb Room Size" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding Effects.ReverbRoomSize}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Effects.ReverbRoomSize, StringFormat={}{0:P0}}" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!-- STATUS FOOTER                                                     -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#12151A" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,20,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="Target Latency: &lt;20ms | WASAPI 48kHz Stereo" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
